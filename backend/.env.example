# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# =============================================================================

# Tipo de base de datos (sqlite o postgresql)
DB_ENGINE=postgresql

# PostgreSQL Configuration
DB_NAME=percapita_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# SQLite Configuration (alternativo, para desarrollo)
# DB_ENGINE=sqlite
# SQLITE_DB_PATH=db.sqlite3

# =============================================================================
# SEGURIDAD
# =============================================================================

# IMPORTANTE: Cambiar en producción por una clave única y segura
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION

# Debug Mode (NUNCA en producción)
DEBUG=True

# Hosts permitidos (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1

# Contraseña de administrador para operaciones sensibles (DELETE)
ADMIN_DELETE_PASSWORD=admin_password_here

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================

# URLs permitidas para CORS (separadas por comas)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Permitir cookies en requests CORS
CORS_ALLOW_CREDENTIALS=True

# =============================================================================
# ARCHIVOS MEDIA Y STATIC
# =============================================================================

# URL base para archivos media (uploads)
MEDIA_URL=/media/

# Directorio para almacenar archivos media
MEDIA_ROOT=media/

# URL base para archivos static
STATIC_URL=/static/

# Directorio para collectstatic
STATIC_ROOT=staticfiles/

# =============================================================================
# CACHE
# =============================================================================

# Backend de cache (locmem, redis, memcached)
CACHE_BACKEND=locmem

# Redis Configuration (si se usa)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# EMAIL (opcional, para notificaciones)
# =============================================================================

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password

# =============================================================================
# CONFIGURACIÓN DE APLICACIÓN
# =============================================================================

# Zona horaria
TIME_ZONE=America/Santiago

# Idioma
LANGUAGE_CODE=es-cl

# =============================================================================
# LOGGING (opcional)
# =============================================================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Directorio para logs
LOG_DIR=logs/
